{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024"]
  },
  "include": [
    "scripts/assets/**/*.ts",
    "scripts/deployment/**/*.ts",
    "tests/assets/**/*.ts",
    "tests/deployment/**/*.ts"
  ]
}
