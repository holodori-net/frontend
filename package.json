{
  "name": "holodori-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:fetch": "curl --fail --location --create-dirs --progress-bar --remove-on-error --output .data/master.sqlite https://github.com/holodori-net/android-database/releases/latest/download/master.sqlite",
    "styles:generate": "node scripts/styles/cli.ts",
    "dev": "node scripts/styles/cli.ts && nuxt dev",
    "build": "node scripts/styles/cli.ts && nuxt prepare && nuxt build",
    "generate": "node scripts/styles/cli.ts && nuxt prepare && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "node scripts/styles/cli.ts && nuxt prepare && nuxt typecheck && tsc --project tsconfig.worker.json && tsc --project tsconfig.data.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.1.0",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.5",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.1.2",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.21",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@primevue/core": "^4.5.5",
    "@primevue/metadata": "^4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tinypool": "^1.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11",
    "workbox-precaching": "^7.4.1"
  }
}
